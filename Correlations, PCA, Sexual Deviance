    "    + scale_x_continuous(breaks=range(1, len(cols) + 1))\n",
    "    + labs(\n",
    "        x=\"Component\",\n",
    "        y=\"Percentage of variance explained\",\n",
    "        title=\"Scree plot\",\n",
    "    )\n",
    ")\n",
    "\n",
    "scree_plot.save(\"scree_plot.png\", dpi=300)\n",
    "scree_plot"
