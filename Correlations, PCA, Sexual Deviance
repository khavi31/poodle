    "#scree plot\n",
    "scree = pd.DataFrame(\n",
    "    {\n",
    "        \"component\": range(1, len(cols) + 1),\n",
    "        \"percent\": pca.explained_variance_ratio_ * 100,\n",
    "    }\n",
    ")\n",
    "scree[\"label\"] = scree[\"percent\"].map(lambda p: f\"{p:.1f}%\")\n",
    "\n",
    "scree_plot = (\n",
    "    ggplot(scree, aes(\"component\", \"percent\"))\n",
    "    + geom_col(fill=\"#4C78A8\", width=0.7)\n",
    "    + geom_line(aes(group=1))\n",
    "    + geom_point()\n",
