    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "df = pd.read_stata(\"chrisu.DTA\", convert_categoricals=False)\n",
    "\n",
    "# map variable codes to readable labels\n",
    "var_mapping = {\n",
    "    # religious practices\n",
    "    \"V25\": \"pray_freq\",  # About how often do you pray?\n",
    "    \"V26\": \"table_grace\",  # Table prayers of grace before/after meals\n",
    "    \"V27\": \"pray_self\",  # Pray about own personal needs\n",
    "    \"V28\": \"pray_close\",  # Pray about needs of people close to you\n",
    "    \"V29\": \"pray_others\",  # Pray about needs of others / current affairs\n",
    "    \"V34\": \"attend_services\",  # How often do you attend religious services now?\n",
    "    # religious beliefs\n",
    "    \"V30\": \"god_close\",  # How close do you feel to God most of the time?\n",
    "    \"V39\": \"bible_inerrant\",  # Bible contains no errors / infallible Word of God\n",
    "    \"V41\": \"bible_morality\",  # Bible is the final and complete guide to morality\n",
    "}\n",
    "\n",
    "# subset and rename columns\n",
    "subset_df = df[list(var_mapping.keys())].rename(columns=var_mapping)\n",
    "\n",
    "# correlation matrix --> spearman correlation\n",
    "corr_matrix = subset_df.corr(method=\"pearson\")\n",
    "\n",
    "# correlation heatmap\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(\n",
    "    corr_matrix,\n",
    "    annot=True,\n",
    "    fmt=\".2f\",\n",
    "    cmap=\"coolwarm\",\n",
    "    vmin=-1,\n",
    "    vmax=1,\n",
    "    center=0,\n",
    "    square=True,\n",
    "    linewidths=0.5,\n",
    ")\n",
    "\n",
    "plt.title(\"Correlation Heatmap: Religious Practices & Beliefs\", pad=16)\n",
    "plt.xticks(rotation=45, ha=\"right\")\n",
    "plt.yticks(rotation=0)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
