    "from plotnine import *\n",
    "from marginaleffects import avg_comparisons\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "belief_vars = ['god_close', 'bible_inerrant', 'bible_morality']   # everything else in rel_vars = practices\n",
    "\n",
    "def plot_ame(model, variables, labels=None, title='Average marginal effects (95% CI)'):\n",
    "    # Average marginal effects as a pandas dataframe\n",
    "    ame_df = avg_comparisons(model, variables=variables).to_pandas()\n",
    "\n",
    "    # Tag each row as a belief or a practice (before labels are renamed)\n",
    "    ame_df['Type'] = np.where(ame_df['term'].isin(belief_vars), 'Beliefs', 'Practices')\n",
    "\n",
    "    # Row labels: categorical terms use the contrast (\"Black vs. White\");\n",
    "    # continuous terms use the variable name plus \"(+1 unit)\"\n",
    "    ame_df['label'] = ame_df['contrast'].str.replace(' - ', ' vs. ', regex=False)\n",
    "    cont = ame_df['contrast'].isin(['+1', '+1.0'])\n",
    "    ame_df.loc[cont, 'label'] = ame_df.loc[cont, 'term'] + ' (+1 unit)'\n",
    "    if labels:\n",
    "        ame_df['label'] = ame_df['label'].replace(labels)       # optional nicer names\n",
    "\n",
    "    # Probabilities to percentage points\n",
    "    ame_df['pp'] = ame_df['estimate'] * 100\n",
    "    ame_df['lo'] = ame_df['conf_low'] * 100\n",
    "    ame_df['hi'] = ame_df['conf_high'] * 100\n",
    "\n",
    "    # Reverse the order so the first term appears at the top of the plot\n",
    "    ame_df['label'] = pd.Categorical(ame_df['label'], categories=ame_df['label'].tolist()[::-1])\n",
    "\n",
    "    return (\n",
    "        ggplot(ame_df, aes(x='pp', y='label', color='Type'))\n",
    "        + geom_vline(xintercept=0, linetype='dashed', color='grey')   # no-effect line\n",
    "        + geom_errorbarh(aes(xmin='lo', xmax='hi'), height=0.2)       # 95% CI\n",
    "        + geom_point(size=3)\n",
    "        + scale_color_manual(values={'Beliefs': '#1F77B4', 'Practices': '#FF7F0E'})   # blue / orange\n",
    "        + labs(x='Change in probability of deviant = 1 (percentage points)', y='', title=title, color='')\n",
    "        + theme_minimal()\n",
    "    )\n",
    "\n",
    "nice = {\n",
    "    'pray_freq (+1 unit)': 'Prayer frequency',\n",
    "    'table_grace (+1 unit)': 'Table grace',\n",
    "    'pray_self (+1 unit)': 'Pray for self',\n",
    "    'pray_close (+1 unit)': 'Pray for close others',\n",
    "    'pray_others (+1 unit)': 'Pray for others/world',\n",
    "    'attend_services (+1 unit)': 'Attend services',\n",
    "    'god_close (+1 unit)': 'Closeness to God',\n",
    "    'bible_inerrant (+1 unit)': 'Bible inerrant',\n",
    "    'bible_morality (+1 unit)': 'Bible as moral guide',\n",
    "}\n",
    "\n",
    "plot_ame(logit_items, rel_vars, labels=nice)"
   ]
