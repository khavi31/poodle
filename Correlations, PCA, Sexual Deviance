    "\n",
    "import os\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from plotnine import *\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# could not find chris.dta fro some reason -- locate and load chrisu.dta automatically\n",
    "skip_dirs = {\".venv\", \"venv\", \"node_modules\", \".git\", \".Trash\", \"Applications\", \".cache\", \"__pycache__\"}\n",
    "search_roots = [\n",
    "    Path.cwd(),\n",
    "    Path.home() / \"Desktop\",\n",
    "    Path.home() / \"Documents\",\n",
    "    Path.home() / \"Downloads\",\n",
    "    Path.home() / \"Library\" / \"Mobile Documents\",\n",
    "]\n",
    "\n",
    "matches = []\n",
    "for root in search_roots:\n",
    "    if not root.exists():\n",
    "        continue\n",
    "    for dirpath, dirnames, filenames in os.walk(root):\n",
    "        dirnames[:] = [d for d in dirnames if d not in skip_dirs and not d.startswith(\".\")]\n",
    "        for fname in filenames:\n",
    "            if fname.lower() == \"chrisu.dta\":\n",
    "                matches.append(Path(dirpath) / fname)\n",
    "\n",
    "if not matches:\n",
    "    raise FileNotFoundError(\n",
    "        \"Could not find chrisu.dta in the current directory, Desktop, Documents, Downloads, or iCloud Drive.\"\n",
    "    )\n",
    "\n",
    "\n",
    "data_path = next(\n",
    "    (p for p in matches if \"religion_logit\" in str(p).lower()),\n",
    "    matches[0],\n",
    ")\n",
    "print(f\"Loaded file: {data_path}\\n\")\n",
    "\n",
    "# convert_categoricals=False keeps underlying numeric codes from stata (.dta)\n",
    "raw_df = pd.read_stata(data_path, convert_categoricals=False)\n",
    "\n",
    "# prep variables\n",
    "var_map = {\n",
    "    # religious practices\n",
    "    \"V25\": \"pray_freq\",\n",
    "    \"V26\": \"table_grace\",\n",
    "    \"V27\": \"pray_self\",\n",
    "    \"V28\": \"pray_close\",\n",
    "    \"V29\": \"pray_others\",\n",
    "    \"V34\": \"attend_services\",\n",
    "    # religious beliefs\n",
    "    \"V30\": \"god_close\",\n",
    "    \"V39\": \"bible_inerrant\",\n",
    "    \"V41\": \"bible_moral_code\",\n",
    "}\n",
    "\n",
    "df = raw_df[list(var_map.keys())].rename(columns=var_map).copy()\n",
    "cols = list(var_map.values())\n",
    "\n",
    "for c in cols:\n",
    "    df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n",
    "\n",
    "work = df.dropna(subset=cols).copy()\n",
    "print(f\"Complete cases retained: {len(work)} of {len(df)}\\n\")\n",
    "print(\"=== Summary Statistics ===\")\n",
    "print(work[cols].describe().round(2))\n",
    "\n",
    "# normalise varibles -- scale (mean 0, SD 1) and fit PCA\n",
    "X = StandardScaler().fit_transform(work[cols])\n",
    "pca = PCA().fit(X)\n",
    "\n",
    "pc_names = [f\"PC{i}\" for i in range(1, len(cols) + 1)]\n",
    "prop = pca.explained_variance_ratio_\n",
    "\n",
    "variance_table = pd.DataFrame(\n",
    "    {\n",
    "        \"Standard deviation\": pca.explained_variance_ ** 0.5,\n",
    "        \"Proportion of variance\": prop,\n",
    "        \"Cumulative proportion\": prop.cumsum(),\n",
    "    },\n",
    "    index=pc_names,\n",
    ").T.round(3)"
   ]
  },
